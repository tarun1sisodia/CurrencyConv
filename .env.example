# Public site origin used for canonical URLs, sitemap, hreflang, and widget embed snippets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ExchangeRate-API key (server-only — never expose to the client).
# Free tier: https://www.exchangerate-api.com/
# If omitted, the open endpoint (open.er-api.com) is used, then Frankfurter as fallback.
EXCHANGERATE_API_KEY=

# Optional Sentry DSN for client + server error reporting. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Shared secret that authorizes the Vercel Cron job hitting GET /api/alerts?cron=1
CRON_SECRET=

# Optional: set to "true" to enable Next.js bundle analyzer on build
# ANALYZE=false
